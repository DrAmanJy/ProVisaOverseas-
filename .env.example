# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# NEXT_PUBLIC_BASE_URL: Your production domain (used for SEO, sitemap, robots.txt, OG tags).
NEXT_PUBLIC_BASE_URL="https://www.provisaoverseas.com"

# Nodemailer / Gmail Configuration:
# 1. Enter your Gmail address:
GMAIL_USER="your-email@gmail.com"

# 2. Enter a Gmail 16-character App Password (generate at https://myaccount.google.com/apppasswords):
GMAIL_APP_PASSWORD="your-16-char-app-password"

# 3. Optional: Email address where you want to receive inquiries (defaults to GMAIL_USER if empty):
CONSULTATION_RECEIVER_EMAIL="provisaoverseas@gmail.com"
